# Local development — copy to `.env` (never commit `.env`)

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (dev-only credentials; rotate for production)
DATABASE_URL=postgresql://itdms:itdms_dev_password@127.0.0.1:5433/itdms_dev?schema=public

LOG_LEVEL=info

# Production: use 32+ char secret, HTTPS, and set CORS_ORIGIN if browser hits API directly
SESSION_SECRET=change-this-to-a-long-random-dev-secret

# Optional: required when SPA origin differs from API (include CSRF header in client)
# CORS_ORIGIN=https://itdms.example.com

STORAGE_ROOT=./storage

# Tests use DATABASE_URL=itdms_test and STORAGE_ROOT=./storage-test (see tests/setup.ts).
# Staging uses apps/api/.env.staging and ./storage-staging — see docker-compose.staging.yml.
NOTIFICATION_LEAD_DAYS=60
