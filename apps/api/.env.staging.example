# Staging (local LAN rehearsal) — copy to `.env.staging` and load when starting API.
# Never commit `.env.staging`. Do not use on client production until IT rewrites secrets.

NODE_ENV=production
ITDMS_STAGING_STRICT=1
ITDMS_TRUST_PROXY=0
PORT=3002

DATABASE_URL=postgresql://itdms_staging:itdms_staging_local_only@127.0.0.1:5434/itdms_staging?schema=public

LOG_LEVEL=info

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=a1b2c3d4e5f6789012345678abcdef9012345678abcdef9012345678abcdef90

SESSION_COOKIE_NAME=itdms_session

# Browser origin when Next.js staging runs on 3011 (adjust for real LAN hostname)
CORS_ORIGIN=http://127.0.0.1:3011

# Single canonical storage tree for staging — not storage-test
STORAGE_ROOT=./storage-staging

NOTIFICATION_LEAD_DAYS=30

# Set to 0 for empty DB after migrate; set to 1 once to load UAT fixture users (PROPOSED roles)
ITDMS_STAGING_SEED_UAT=1
