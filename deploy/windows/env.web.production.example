# ITDMS Web — production template (copy to apps/web/.env.local on the Windows host)
# Do NOT commit the real .env.local file.

# Next.js server-side proxy to API (same machine: loopback)
ITDMS_API_URL=http://127.0.0.1:3000
ITDMS_SESSION_COOKIE_NAME=itdms_session

# Production listen port for `next start` (match firewall / bookmark URL)
# PORT=3011
