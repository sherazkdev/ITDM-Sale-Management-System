# Isolated Wave 6 rehearsal — copy to rehearsal/config/api.env (NOT production)
# Use a dedicated database; do not point at itdms_dev or itdms_staging.

NODE_ENV=production
ITDMS_STAGING_STRICT=1
PORT=3010

DATABASE_URL=postgresql://itdms:REHEARSAL_DB_PASSWORD@127.0.0.1:5433/itdms_deploy_rehearsal?schema=public

LOG_LEVEL=info
SESSION_SECRET=REHEARSAL_REPLACE_WITH_32_PLUS_RANDOM_CHARS

STORAGE_ROOT=REHEARSAL_ROOT/data/storage/private
BACKUP_DIR=REHEARSAL_ROOT/data/backups

NOTIFICATION_LEAD_DAYS=60
