# ITDMS API — production template (copy to apps/api/.env on the Windows host)
# Replace ALL placeholder values before first start. Do NOT commit the real .env file.

NODE_ENV=production
ITDMS_STAGING_STRICT=1
PORT=3000

# Local PostgreSQL on standalone PC (adjust host/port/db/user/password)
DATABASE_URL=postgresql://ITDMS_DB_USER:CHANGE_ME@127.0.0.1:5432/itdms_prod?schema=public

LOG_LEVEL=info

# Generate with: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
SESSION_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET

STORAGE_ROOT=D:/ITDMS/data/storage/private

NOTIFICATION_LEAD_DAYS=60

# Optional — only when browser talks to API on a different origin (LAN phase)
# CORS_ORIGIN=http://127.0.0.1:3011

# Optional — behind IIS/nginx reverse proxy with TLS termination
# ITDMS_TRUST_PROXY=1
