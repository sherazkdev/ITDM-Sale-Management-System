# Copy to Render dashboard (never commit filled values).
# Database: Neon PostgreSQL demo project ONLY (not itdms_dev / test / e2e).

NODE_ENV=production
ITDMS_STAGING_STRICT=1
ITDMS_TRUST_PROXY=1
HOST=0.0.0.0
PORT=10000

# Neon: use pooled URL for runtime; run migrate deploy with direct URL if Neon requires it.
DATABASE_URL=postgresql://USER:PASSWORD@EP-XXXX.neon.tech/itdms_demo?sslmode=require

# openssl rand -base64 48  (min 32 chars)
SESSION_SECRET=<GENERATE_48_CHAR_SECRET>

LOG_LEVEL=info
NOTIFICATION_LEAD_DAYS=60

# Ephemeral disk on Render Free — uploads/downloads may not survive restarts.
STORAGE_ROOT=/tmp/itdms-storage

# Provision via Render Secret Files (binary), not git:
ITDMS_ISSUANCE_TEMPLATE_PATH=/etc/secrets/Issuance.xlsx
ITDMS_RETURN_TEMPLATE_PATH=/etc/secrets/Return.xlsx

# Leave unset when Netlify proxies /api/v1 (recommended):
# CORS_ORIGIN=