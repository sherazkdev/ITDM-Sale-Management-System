# Netlify site environment (never commit filled values).
# No NEXT_PUBLIC_ secrets — only public site URL if needed for SEO guards.

NODE_VERSION=20

# Server-side only: Render API external URL (no trailing slash).
ITDMS_API_URL=https://itdms-api-demo.onrender.com

